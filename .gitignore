# Python
__pycache__/
*.py[cod]

# Virtual environment
.venv/

# Pytest
.pytest_cache/
pytest-of-*/

# Coverage
.coverage
htmlcov/

# Metaflow
.metaflow/

# Project-specific
data-tmp/
tmp/
*.parquet
*.pkl
*.csv
# Hand-off example files are small and meant to be shared; keep them tracked.
!templates/**/*.csv
*.zip
logs/*
!logs/_index.md

# Worktrees live under .claude/worktrees/; each has its own git state and should not be tracked by the parent
.claude/worktrees/

# Param-scan outputs — regenerable via `scripts/run_param_scan.py` / `scripts/run_pinned_scan.py`
param_scan_results/
param_scan_results_pinned/
research/param-scans/results/
research/param-scans/pinned/
# Per-probe run logs (verbose mozaic stdout; the FINDINGS.md carries the conclusions).
research/param-scans/*/*/logs/
# Search reports embed plotly.js inline so they open offline -- ~4.5MB each, and they are
# regenerated on every rebuild. Kept out of history; each has a one-command producer, e.g.
#   python research/param-scans/summer-trough-v2/build_grid_report.py
research/param-scans/*/*_report.html
# ...but DO track their scored inputs (~10-30KB each), so results survive in git and every
# report is reproducible without re-running the probes.
!research/param-scans/*/*_scores.csv
!research/param-scans/*/*_slopes.csv
!research/param-scans/*/*_pairs.csv

# Data directories (large files archived to GCS — see follow-up in monthly-forecast-update.md)
# data-official/ is NOT fully ignored: *.json and *.md parameter files are committed,
# data files (*.parquet, *.pkl, *.csv) are caught by the global rules above.
# Marketing-lift model inputs (small, configuration-like) ARE tracked under
# data-official/{YYYY-MM}/marketing/ so the pipeline can apply the `m` adjustment.
!data-official/*/marketing/*.parquet
# MozillaOnline migration model inputs (small) ARE tracked under
# data-official/{YYYY-MM}/mozillaonline/ so the `o` adjustment + build script are
# reproducible from git (model parquet + cached telemetry source CSVs).
!data-official/*/mozillaonline/*.parquet
!data-official/*/mozillaonline/source_data/*.csv
# Launch-on-login (`l`) overlay curve input (small, ~10KB) ARE tracked under
# data-official/{YYYY-MM}/launch_on_login/ so the pipeline can apply the `l` adjustment.
!data-official/*/launch_on_login/*.parquet
# Paid/organic split (`p`) input: the measured Fenix organic share by date x country
# (~350KB). Tracked for the same reason as the three above -- the pipeline cannot run the
# mobile forecast without it, and its producer depends on a scratch mirror table that
# expires 2027-04-01, so git is the durable copy.
!data-official/*/organic/*.parquet
# September 2026 desktop overlays `j` (japan_bot) and `i` (india_excess): the scenario curves the
# pipeline loads (~160 KB total). Tracked for the same reason; the sibling .csv copies are
# read-only duplicates of the same numbers and stay ignored.
!data-official/*/japan_bot/*.parquet
!data-official/*/india_excess/*.parquet
# Public-facing canonical exports: small (<100KB), referenced by the README
# next to them, regenerable via export_canonical_curves.py. Tracked so
# downstream consumers don't need to run the export script. The csv/ folder
# holds the ALL-level canonical curves plus one no-headwind CSV per country.
!data-official/*/csv/june_canonical_curves.csv
!data-official/*/csv/july_canonical_curves.csv
!data-official/*/csv/july_dec15_summary.csv
!data-official/*/csv/august_canonical_curves.csv
!data-official/*/csv/august_dec15_summary.csv
# Desktop-only, `h`-removed counterfactual twins of the pair above (produced by
# scripts/export_desktop_no_headwind_csv.py). Tracked so the two files always travel with
# the README section that says they are NOT the published forecast -- shipping the loud
# filename without that context is the failure mode worth spending 30KB to avoid.
!data-official/*/csv/*.DESKTOP_ONLY.WIN10_HEADWIND_REMOVED.csv
# Desktop-only ex-Iran/ex-China scope, in both headwind states (produced by
# scripts/export_desktop_ex_ir_cn_csv.py). Tracked for the same reason: the ex-IR/CN
# August-vs-July delta is NEGATIVE where the published one is positive, so these must
# travel with the README section that explains the scope rather than circulate bare.
!data-official/*/csv/*.DESKTOP_ONLY.EX_IR_CN.csv
!data-official/*/csv/*.DESKTOP_ONLY.WIN10_HEADWIND_REMOVED.EX_IR_CN.csv
!data-official/*/csv/per_country/*.no-headwinds.csv
!data-official/*/june_canonical_curves.csv
!data-official/*/april_composite_forecast_28ma.adj-h.csv
# Win10 headwind anchor-validation extracts: small, and the notebook in
# research/headwinds/ is only reproducible without a 515 GB BigQuery scan if these ship.
!research/headwinds/extracts/*.csv
!data-official/*/stakeholder_scenarios_*.zip
data/
# Provenance + computed results for the forecast-vs-summer-actuals audit: small JSON, and the
# record of how that report's numbers were produced. The directory itself must be un-ignored first
# -- git does not descend into an excluded directory, so a bare `!.../data/*.json` would be inert.
# The 1.9 MB actuals parquet beside them is re-ignored: it is regenerable by `fetch_actuals.py`.
!research/forecast-vs-summer-actuals/data/
research/forecast-vs-summer-actuals/data/*.parquet
# Fitted-model pickles are ~630 MB each and are fetched from the GCS archive on demand.
research/forecast-vs-summer-actuals/data/pkl/
data-mozaic/
april-by-hand/
remote-logs/

# Build artifacts
src/mozaic_daily.egg-info/
build/
dist/

# OS
.DS_Store

# Debug files
docker/Dockerfile.bak
docker/Dockerfile.plus1
test_files/

# Scratch downloads (Looker replicas, ad-hoc exports) — not durable project work
tmp_downloads/

# Handoff staging dirs: the unzipped contents are a build artifact duplicating
# the tracked csv/ source + the (gitignored, GCS-archived) handoff zip. Keep
# only handoff/_index.md, which documents what the zip contains.
data-official/*/handoff/*_handoff/

# Editor/backup copies of notebooks
*.copy.ipynb

# japan_bot (`j`): curve parquet + delivered source, ingested 2026-09-04
!data-official/*/japan_bot/source_data/*

# india_excess (`i`): curve parquet + delivered source, ingested 2026-09-04
!data-official/*/india_excess/source_data/*

# mozillaonline (`o`): curve parquet + delivered source, ingested 2026-09-04
!data-official/*/mozillaonline/source_data/*

# headwinds (`h`): curve parquet + delivered source, ingested 2026-09-04
!data-official/*/headwinds/*.parquet
!data-official/*/headwinds/source_data/*

# 2026-09 marketing: the GMIO query output + workbook that the `p` paid curve is built from
!data-official/*/marketing/source_data/*
!data-official/*/marketing/*.xlsx
